{"_data": [{"contents": [{"content": "Peter Visits Vanessa at Work", "type": "lesson_name"}, {"content": "Don't Fall Asleep!", "type": "unit_name"}, {"content": 8, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "B1.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Exchange advice and suggestions in communicative situations.", "type": "primary"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_1"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_2"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_3"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_4"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_5"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_6"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_7"}, {"content": "Writes an exchange of written communications about asking for and giving advice on problems with technology or gadgets through the correct use of spelling, grammar, vocabulary, level of formality, cohesion and coherence aspects appropriated to this level. ", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Subject and Object Relative Clauses", "type": "heading"}, {"content": "You use relative clauses to make clear which person or thing we are talking about.", "type": "describer"}, {"content": "When you use a relative clause to replace a noun, you use <span class=\"italic\">who</span>, <span class=\"italic\">whose</span>, <span class=\"italic\">which</span> or  <span class=\"italic\">that</span>.", "type": "text"}, {"content": "Example:<br/><span class=\"italic\">I was forced to contact an electrician who arrived before 8 a.m.</span>", "type": "text"}, {"content": "{\"rows\":7,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Relative Pronoun</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Use</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"who\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"subject or object pronoun for people\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I told you about the electrician who left a mess everywhere.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"which\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"subject or object pronoun for animals and things\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Did you see the mouse which was on top of the counter?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"which\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"referring to a whole sentence\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">He couldn't escape the fees, which surprised me.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"whose\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"possession for people, animals and things\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Do you know that employee whose boss behaved unprofessionally?</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"whom\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"object pronoun for people (people often use who)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">He was invited by the manager whom he met on the weekend.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"that\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"subject or object pronoun for people, animals and things (who and which are also possible)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Can you pass me the chair that is against the wall?</span>\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}], "type": "learning_points"}, {"contents": [{"content": "Asking for Help and Advice (How to / where to / what to + verb)", "type": "heading"}, {"content": "There are several ways to ask for help in English. You can use polite and casual language to do this. Let's look at one particular structure for asking for help.", "type": "describer"}, {"content": "You can use the structure <br/>Can/Could + you + show/tell+ me+ Question word", "type": "text"}, {"content": "<span class=\"italic\">Can you show me how to fix the electrical problem?<br/>Could you tell me where to send the invoice?<br/>Could you show me what you painted?</span>", "type": "text"}, {"content": "You can also use the structure<br/>Let me show/tell + you + question word", "type": "text"}, {"content": "<span class=\"italic\">Let me show you how to stand.<br/>Let me show you where it is.<br/>Let me tell you what you should do.</span>", "type": "text"}, {"content": "Could you tell me where to send the invoice from the electrician and the one related to the spoiled food? ", "type": "example"}, {"content": "Can you explain to me how to run a restaurant in this state? ", "type": "example"}, {"content": "Can you tell me what to do with the food that is sitting  in our fridges?", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "renovation", "type": "name"}, {"content": "to make changes and repairs to an old house, building or room", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Bistro 88 is doing a lot of renovations.", "type": "example"}, {"content": "engenn7le07ob08aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use in an e-mail to a business.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "firm", "type": "name"}, {"content": "a business organization", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Mr. Sawyer's firm hires contractors to complete the work.", "type": "example"}, {"content": "engenn7le07ob08aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "state", "type": "name"}, {"content": "the overall physical condition of something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The restaurant was in a terrible state.", "type": "example"}, {"content": "engenn7le07ob08aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "debris", "type": "name"}, {"content": "things that are lying where they fell or that have been left somewhere because they are not wanted", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: There was debris everywhere.", "type": "example"}, {"content": "engenn7le07ob08aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "carpenter", "type": "name"}, {"content": "a person whose job it is to make or fix wooden objects or wooden parts of buildings", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The carpenter left his equipment in the kitchen.", "type": "example"}, {"content": "engenn7le07ob08aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "electrician", "type": "name"}, {"content": "a person who works on and repairs electrical equipment", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: An electrician was called to provide assistance.", "type": "example"}, {"content": "engenn7le07ob08aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "temporary", "type": "name"}, {"content": "continuing for a limited amount of time; not permanent", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He was able to give the restaurant temporary power.", "type": "example"}, {"content": "engenn7le07ob08aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "repeated", "type": "name"}, {"content": "said, done, or happening again and again", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You did not answer my repeated calls.", "type": "example"}, {"content": "engenn7le07ob08aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "client", "type": "name"}, {"content": "a person who pays a professional person or organization for service", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Bistro 88 is a client of the firm.", "type": "example"}, {"content": "engenn7le07ob08aud09", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "spoiled", "type": "name"}, {"content": "to decay or lose freshness especially because of being kept too long", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There was spoiled food in the fridges.", "type": "example"}, {"content": "engenn7le07ob08aud10", "type": "audio"}], "type": "target_word"}, {"content": "engenn7le07ob08re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Write a 10 - 12 line telephone dialogue between you and the company who is doing renovations at the restaurant.", "type": "text"}, {"content": "Tell the company you sent them an e-mail.", "type": "text"}, {"content": "Describe how you feel.", "type": "text"}, {"content": "Ask 2 questions using the structure <span class=\"italic\">Can/Could + you + show/tell + me + Question word</span>", "type": "text"}, {"content": "Use two relative clauses like <span class=\"italic\">that</span> and <span class=\"italic\">who</span>.", "type": "text"}, {"content": "Read the dialogue aloud with a partner.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write a 10 - 12 line dialogue about a customer complaint.", "type": "text"}, {"content": "I use relative clauses in a dialogue to a business.", "type": "text"}, {"content": "I use relative clauses to describe a situation or event.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"template_override": 1, "contents": [{}], "_data": [], "id": 0, "type": "welcome"}, {"template_override": 1, "_data": [], "title": "", "type": "audio", "contents": [{"value": {"images": [{"image": "engenn7le07ob08re2img05.jpg", "time": "0", "id": 0, "text": ""}, {"image": "engenn7le07ob08re2img05.jpg", "time": "100", "id": 1, "text": "To Mr. Sawyers, <br/><br/><p>I am writing to you with regards to renovations that your firm is completing at Bistro 88.</p><p>I am not impressed by the nightmare that I witnessed early yesterday morning.</p> <p>I arrived at work at 6 a.m. to find a complete mess. I am extremely disappointed at the lack of professionalism shown by your staff. How are we supposed to run a restaurant in this state?</p>"}, {"image": "engenn7le07ob08re2img01.jpg", "time": "27000", "id": 2, "text": "<p>The front of house was appalling. Chairs and tables were pushed up against the walls, the power wasn't working and there was debris everywhere. The carpenters and painters also left their equipment behind. The kitchen was filthy and a number of appliances were missing, including our brand-new microwaves. What are we now going to do with the food that is sitting in our fridges? We had no power overnight.</p>\n<p>I was forced to contact an electrician who arrived before 8 a.m. to provide us with temporary power.  We were forced to close the restaurant for 24 hours.</p>\n<p>Your company did not answer my repeated calls to clean up this disaster until that afternoon.</p>"}, {"image": "engenn7le07ob08re2img02.jpg", "time": "69500", "id": 3, "text": "<p>I would suggest that your contractors learn how to work appropriately in a client's place of business.</p>\n<p>Could you tell me where to send the invoice from the electrician and the ones related to the spoiled food?</p>\n<p>Your company came highly recommended to me, which is why we trusted your firm. We did not sign up for this, nor are we prepared to pay for your mistakes.</p>\n<br/>Sincerely,<br/><br/>Vanessa Wright<br/>Restaurant Manager"}], "audiosrc": "engenn7le07ob08re2aud01", "coverimg": "engenn7le07ob08re2img05.jpg"}, "type": "slideshow"}], "id": 1}, {"template_override": 1, "_data": [], "title": "", "type": "video", "contents": [{"value": {"images": [{"image": "", "time": "8000", "id": 0, "text": "<span class=\"bullet\">What is a relative clause?</span>"}, {"image": "", "time": "74000", "id": 1, "text": "<span class=\"bullet\">Use of Which.</span>"}, {"image": "", "time": "110000", "id": 2, "text": "<span class=\"bullet\">Use of Whose.</span>"}, {"image": "", "time": "128000", "id": 3, "text": "<span class=\"bullet\">Use of Whom.</span>"}, {"image": "", "time": "145000", "id": 4, "text": "<span class=\"bullet\">Use of That.</span>"}], "video_src": "engenn7le07ob08re3vid01"}, "type": "video"}], "id": 2}], "exercises": [{"template_override": 1, "_data": [{"contents": [{"content": "I can write a short e-mail.", "type": "Learning Outcomes"}, {"content": "I can write complex statements using words like <span class=\"italic\">who</span>, <span class=\"italic\">that</span> or <span class=\"italic\">which</span>.", "type": "Learning Outcomes"}, {"content": "I can ask for help or advice.", "type": "Learning Outcomes"}, {"content": "Have you experienced poor service from a business before?", "type": "Free Header Item"}, {"content": "What happened? Did you know what to do about it?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "correct_feedback": "Correct", "allowed_attempts": 2}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Writing Spot: Restaurant Nightmares", "type": "free_type_text_area"}], "questions": [], "type": "WLC", "id": 0, "img_path": "", "stimuli_ids": [0]}, {"template_override": 1, "_data": [{"contents": [{"content": " What did Vanessa <span class=\"tool-tip\" id=\"tip_1_0\">witness</span> when she arrived at work? The renovations on Bistro 88 have turned into a nightmare.", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "allowed_attempts": 2}, "type": "feedback"}, {"contents": [{"content": "Reading", "type": "skill"}, {"content": "Listening", "type": "skill"}], "type": "learning_skills"}, {"content": [{"content": "To <span class=\"italic\">\"witness\"</span> means to see something happen.", "tip_id": 0, "type": "text"}], "type": "tips"}, {"contents": [{"content": "Instructions: Click on the play button to listen to the audio.", "type": "text"}], "type": "post_instructions"}], "questions": [{"_data": [{"contents": [{"content": "", "type": "text"}], "type": "question"}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}], "type": "STI", "id": 1, "stimuli_ids": [1]}, {"template_override": 1, "_data": [{"contents": [{"content": " Was the behavior of the building firm <span class=\"tool-tip\" id=\"tip_2_0\">inexcusable</span>?", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Activity 1", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"},